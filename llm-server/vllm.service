# /etc/systemd/system/vllm.service
[Unit]
Description=vLLM server (Qwen3.8-27B INT4-AWQ)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=andy-stanciu
WorkingDirectory=/home/andy-stanciu/workplace/atlas/llm-server
Environment=CUDA_HOME=/usr
ExecStart=/home/andy-stanciu/workplace/atlas/llm-server/.venv/bin/vllm serve abihsoro/Qwen3.8-27B-AWQ-INT4 \
  --served-model-name qwen3.8:27b \
  --host 0.0.0.0 --port 8000 \
  --max-model-len 8192 \
  --gpu-memory-utilization 0.78 \
  --max-num-seqs 1 \
  --kv-cache-dtype fp8 \
  --enable-auto-tool-choice --tool-call-parser qwen3_coder \
  --reasoning-parser qwen3 \
  --default-chat-template-kwargs '{"enable_thinking": false}' \
  --enable-prefix-caching --mamba-cache-mode align \
  --trust-remote-code
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
ExecStartPost=/bin/bash -c 'until curl -sf http://127.0.0.1:8000/health >/dev/null; do sleep 2; done'

[Install]
WantedBy=multi-user.target


